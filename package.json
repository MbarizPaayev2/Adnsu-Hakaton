{
  "name": "aise-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/apply-worker",
    "packages/shared-types"
  ],
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:apply-worker": "npm run start:dev --workspace=apps/apply-worker",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:apply-worker": "npm run build --workspace=apps/apply-worker",
    "db:generate": "npm run prisma:generate --workspace=apps/api",
    "db:push": "npm run prisma:push --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "smoke:e2e": "./scripts/smoke-e2e.sh"
  }
}
