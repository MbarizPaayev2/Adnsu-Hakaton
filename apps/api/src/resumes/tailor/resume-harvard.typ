// Preamble (auto-generated by resume-tailor.service.ts):
// #let data = (...)
//
// Harvard OCS-style resume: single column, serif, monochrome — the
// classic "Institution ... Location" / "Degree ... Dates" right-aligned
// pairing that defines this format, Education before Experience.

#set page(paper: "a4", margin: (x: 20mm, top: 16mm, bottom: 16mm))
// Libertinus Serif ships inside the Typst compiler (OFL), so every host
// renders the same font; it covers Azerbaijani, Russian, English and Turkish.
#set text(font: "Libertinus Serif", size: 10pt, fill: rgb("#232A24"), ligatures: false, lang: data.at("lang", default: "en"))
#set par(leading: 0.55em, justify: false)
#set list(marker: [--], indent: 10pt, body-indent: 6pt, spacing: 0.55em)

// Headings arrive upper-cased for the document's language (see
// resume-tailor.service.ts): Typst's upper() would turn Azerbaijani "i" into
// "I" instead of "İ".
// `sticky` keeps a heading with the first entry below it (a heading alone at the foot of a page is never left behind).
#let sec(label) = {
  v(9pt)
  block(sticky: true, below: 0pt)[
    #text(size: 10.5pt, weight: "bold", fill: rgb("#253B2C"), tracking: 0.06em)[#label]
    #v(1pt)
    #line(length: 100%, stroke: 0.6pt + rgb("#253B2C"))
  ]
  v(4pt)
}

// A row with a bold/italic left label and a right-aligned value —
// the "Institution ... Location" / "Degree ... Dates" pattern repeated
// throughout the Harvard format.
#let row(lhs, rhs, lhs-style: "bold") = grid(
  columns: (1fr, auto),
  gutter: 6pt,
  text(weight: if lhs-style == "bold" { "bold" } else { "regular" },
       style: if lhs-style == "italic" { "italic" } else { "normal" })[#lhs],
  align(right, text(size: 9pt)[#rhs]),
)

// ── data bindings ─────────────────────────────────────────────
#let name-str     = data.at("name",        default: "")
#let headline-str = data.at("headline",    default: "")
#let email-str    = data.at("email",       default: "")
#let phone-str    = data.at("phone",       default: "")
#let loc-str      = data.at("location",    default: "")
#let site-str     = data.at("website_url", default: "")
#let summary-str  = data.at("summary",     default: "")
#let exp-list     = data.at("experience",  default: ())
#let edu-list     = data.at("education",   default: ())
#let skills-list  = data.at("skills",      default: ())
#let langs-list   = data.at("languages",   default: ())
#let proj-list    = data.at("projects",    default: ())
#let certs-list   = data.at("certifications", default: ())
#let act-list     = data.at("activities", default: ())
#let award-list   = data.at("awards", default: ())
#let labels       = data.at("labels", default: (:))
#let headings     = data.at("headings", default: (:))
#let label(key, fallback) = labels.at(key, default: fallback)
#let heading-of(key, fallback) = headings.at(key, default: upper(fallback))

// ── header ──────────────────────────────────────────────────────
#align(center)[
  #text(size: 18pt, weight: "bold")[#name-str]
  #if headline-str != "" [
    #v(2pt)
    #text(size: 10.5pt, style: "italic")[#headline-str]
  ]
  #v(4pt)
  #text(size: 9pt)[
    #{
      let parts = ()
      if loc-str != "" { parts.push(loc-str) }
      if phone-str != "" { parts.push(phone-str) }
      if email-str != "" { parts.push(email-str) }
      if site-str != "" { parts.push(site-str) }
      parts.join("  \u{2022}  ")
    }
  ]
]

#if summary-str != "" {
  v(8pt)
  text(size: 9.5pt)[#summary-str]
}

// ── education (before experience — the Harvard OCS convention) ──
#if edu-list.len() > 0 {
  sec(heading-of("education", "Education"))
  for e in edu-list {
    let degree = e.at("degree", default: "")
    let area   = e.at("area",   default: "")
    let degreeLine = (degree + (if degree != "" and area != "" { ", " } else { "" }) + area).trim()
    let loc    = e.at("location", default: "")
    let grade  = e.at("grade",    default: "")
    block(below: 7pt)[
      #row(e.at("school", default: ""), loc)
      #if degreeLine != "" {
        v(1pt)
        row(degreeLine, e.at("period", default: ""), lhs-style: "italic")
      }
      #if grade != "" {
        v(1pt)
        text(size: 8.5pt, style: "italic")[#grade]
      }
    ]
  }
}

// ── experience ────────────────────────────────────────────────
// An entry is the company row, the title/date row and its bullets. The header stays together with the first bullet; the remaining bullets
// may continue on the next page. Nothing is shortened to make a CV fit.
#if exp-list.len() > 0 {
  sec(heading-of("experience", "Experience"))
  for e in exp-list {
    let highs = e.at("highlights", default: ())
    let item(blt) = [#text(size: 9.5pt)[#blt]]
    let head = [
      #row(e.at("company", default: ""), e.at("location", default: ""))
      #v(1pt)
      #row(e.at("position", default: ""), e.at("period", default: ""), lhs-style: "italic")
    ]
    if highs.len() == 0 {
      block(breakable: false, below: 13pt)[#head]
    } else if highs.len() == 1 {
      block(breakable: false, below: 13pt)[
        #head
        #v(3pt)
        #list(item(highs.first()))
      ]
    } else {
      block(breakable: false, below: 0pt)[
        #head
        #v(3pt)
        #list(item(highs.first()))
      ]
      block(above: 0.55em, below: 13pt, list(..highs.slice(1).map(item)))
    }
  }
}

// ── projects ──────────────────────────────────────────────────
#if proj-list.len() > 0 {
  sec(heading-of("projects", "Projects"))
  for p in proj-list {
    let desc = p.at("description", default: "")
    block(below: 7pt)[
      #row(p.at("name", default: "") + (if p.at("organization", default: "") != "" { ", " + p.at("organization", default: "") } else { "" }), p.at("period", default: ""))
      #if desc != "" {
        v(2pt)
        text(size: 9.5pt)[#desc]
      }
    ]
  }
}

// ── volunteering, leadership and activities (only what the candidate confirmed and chose) ──
#if act-list.len() > 0 {
  sec(heading-of("activities", "Volunteering & Activities"))
  for a in act-list {
    let desc = a.at("description", default: "")
    let org  = a.at("organization", default: "")
    let role = a.at("role", default: "")
    let head = if role != "" and org != "" { role + ", " + org } else if role != "" { role } else if org != "" { org } else { a.at("title", default: "") }
    block(below: 7pt)[
      #row(head, a.at("period", default: ""))
      #if desc != "" {
        v(2pt)
        text(size: 9.5pt)[#desc]
      }
    ]
  }
}

// ── awards ────────────────────────────────────────────────────
#if award-list.len() > 0 {
  sec(heading-of("awards", "Awards"))
  for a in award-list {
    let iss = a.at("issuer", default: "")
    block(below: 4pt)[
      #row(a.at("title", default: "") + (if iss != "" { ", " + iss } else { "" }), a.at("date", default: ""))
    ]
  }
}

// ── skills ────────────────────────────────────────────────────
#if skills-list.len() > 0 {
  sec(heading-of("skills", "Skills"))
  for s in skills-list {
    let nm  = s.at("name",     default: "")
    let kws = s.at("keywords", default: ())
    if kws.len() > 0 {
      block(below: 3pt)[
        #if nm != "" [#text(weight: "bold")[#nm: ]]
        #text(size: 9.5pt)[#kws.join(", ")]
      ]
    }
  }
}

// ── certifications ────────────────────────────────────────────
#if certs-list.len() > 0 {
  sec(heading-of("certifications", "Certifications"))
  for c in certs-list {
    let t = c.at("title", default: "")
    let iss = c.at("issuer", default: "")
    let dt = c.at("date", default: "")
    block(below: 3pt)[
      #row(t + (if iss != "" { ", " + iss } else { "" }), dt)
    ]
  }
}

// ── languages ─────────────────────────────────────────────────
#if langs-list.len() > 0 {
  sec(heading-of("languages", "Languages"))
  block(below: 3pt)[
    #text(size: 9.5pt)[
      #langs-list.map(L => {
        let lang = L.at("language", default: "")
        let flu  = L.at("fluency", default: "")
        if flu != "" { lang + " (" + flu + ")" } else { lang }
      }).join(", ")
    ]
  ]
}
