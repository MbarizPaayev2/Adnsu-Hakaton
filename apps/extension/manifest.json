{
  "manifest_version": 3,
  "name": "AISE Agent",
  "version": "0.3.4",
  "description": "Fills your name, e-mail and phone into employer forms you open, and submits applications only on supported portals after you approve each one in AISE.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://aisehr.com/*",
    "https://jobs.lever.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.lever.co/*"
      ],
      "js": [
        "content/lever.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://aisehr.com/dashboard/agent*",
        "https://www.aisehr.com/dashboard/agent*"
      ],
      "js": [
        "content/aise-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "AISE Agent",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
