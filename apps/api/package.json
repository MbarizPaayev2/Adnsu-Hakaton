{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "script:cleanup-bossaz": "ts-node -r tsconfig-paths/register src/scripts/cleanup-bossaz-jobs.ts",
    "script:cleanup-bossaz:prod": "node dist/scripts/cleanup-bossaz-jobs.js",
    "script:import-glorri-backfill": "ts-node -r tsconfig-paths/register src/scripts/import-glorri-backfill.ts",
    "script:import-glorri-backfill:prod": "node dist/scripts/import-glorri-backfill.js",
    "script:create-admin": "ts-node -r tsconfig-paths/register src/scripts/create-admin.ts",
    "script:repair-glorri-locations": "ts-node -r tsconfig-paths/register src/scripts/repair-glorri-locations.ts",
    "script:repair-glorri-locations:prod": "node dist/scripts/repair-glorri-locations.js",
    "script:backfill-dedup-keys": "ts-node -r tsconfig-paths/register src/scripts/backfill-dedup-keys.ts",
    "script:backfill-dedup-keys:prod": "node dist/scripts/backfill-dedup-keys.js",
    "script:application-outcomes": "ts-node -r tsconfig-paths/register src/scripts/application-outcome-summary.ts",
    "script:application-outcomes:prod": "node dist/scripts/application-outcome-summary.js",
    "script:rescore-profiles": "ts-node -r tsconfig-paths/register src/scripts/rescore-profiles.ts",
    "script:rescore-profiles:prod": "node dist/scripts/rescore-profiles.js",
    "script:repair-stub-cvs": "ts-node -r tsconfig-paths/register src/scripts/repair-stub-parsed-cvs.ts",
    "script:repair-stub-cvs:prod": "node dist/scripts/repair-stub-parsed-cvs.js",
    "script:create-admin:prod": "node dist/scripts/create-admin.js",
    "script:admin-recover": "ts-node -r tsconfig-paths/register src/scripts/admin-recover.ts",
    "script:admin-recover:prod": "node dist/scripts/admin-recover.js",
    "script:remove-account": "ts-node -r tsconfig-paths/register src/scripts/remove-account.ts",
    "script:remove-account:prod": "node dist/scripts/remove-account.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:cv-pdf": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex '.*\\.pdftest\\.ts$'",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "build:local": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "start:local": "node dist/main.js",
    "script:acquisition-metrics": "ts-node -r tsconfig-paths/register src/scripts/report-acquisition-metrics.ts",
    "script:acquisition-metrics:prod": "node dist/scripts/report-acquisition-metrics.js",
    "script:import-public-jobs": "ts-node -r tsconfig-paths/register src/scripts/import-public-jobs.ts",
    "script:import-public-jobs:prod": "node dist/scripts/import-public-jobs.js",
    "script:email-sink": "ts-node -r tsconfig-paths/register src/scripts/email-sink.ts",
    "script:backfill-job-facts": "ts-node -r tsconfig-paths/register src/scripts/backfill-job-facts.ts",
    "script:backfill-job-facts:prod": "node dist/scripts/backfill-job-facts.js",
    "script:relink-duplicates": "ts-node -r tsconfig-paths/register src/scripts/relink-duplicates.ts",
    "script:relink-duplicates:prod": "node dist/scripts/relink-duplicates.js",
    "script:email-pilot-check": "ts-node -r tsconfig-paths/register src/scripts/email-pilot-check.ts",
    "script:email-pilot-check:prod": "node dist/scripts/email-pilot-check.js",
    "script:report-source-coverage": "ts-node -r tsconfig-paths/register src/scripts/report-source-coverage.ts",
    "script:report-source-coverage:prod": "node dist/scripts/report-source-coverage.js",
    "script:audit-employer-sources": "ts-node -r tsconfig-paths/register src/scripts/audit-employer-sources.ts",
    "script:audit-employer-sources:prod": "node dist/scripts/audit-employer-sources.js",
    "script:discover-ats-tenants": "ts-node -r tsconfig-paths/register src/scripts/discover-ats-tenants.ts"
  },
  "dependencies": {
    "@aise/shared-types": "*",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.10.2",
    "@types/sanitize-html": "^2.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dodopayments": "^2.49.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jose": "^4.15.9",
    "pdfjs-dist": "^4.10.38",
    "posthog-node": "^5.51.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^3.2.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.5",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.10.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
