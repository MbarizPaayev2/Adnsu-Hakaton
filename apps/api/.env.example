# apps/api/.env — copy this file to `.env` in apps/api. Never commit `.env`.
#
# LOCAL DEVELOPMENT ONLY. Everything here works offline: mail and payments run
# in mock mode, the Glorri importer and external applications are off. Never
# paste production keys into this file; ask for your own test keys instead.

NODE_ENV=development
APP_ENV=development
PORT=4000

# Local Postgres/Redis from `docker compose up -d postgres redis`.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/aise?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Where links in emails point.
FRONTEND_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3000

# Email: a key containing "mock" logs emails instead of sending them.
# Optional: EMAIL_SINK_PATH=/tmp/aise-emails.jsonl also writes them to a file.
RESEND_API_KEY=re_mock_key

# Payments: a key containing "mock" is local mock checkout; paid checkout
# stays off unless PAYMENTS_ENABLED=true. Keep it false.
DODO_PAYMENTS_API_KEY=mock_dodo_api_key
DODO_ENV=test_mode
DODO_WEBHOOK_KEY=
DODO_PRODUCT_ID_BASIC=mock_basic
DODO_PRODUCT_ID_STANDARD=mock_standard
DODO_PRODUCT_ID_UNLIMITED=mock_unlimited
PAYMENTS_ENABLED=false
# Employer plans (docs/employer-plans-2026-10-11.md). Both stay false until checkout, webhook and publication have passed in the sandbox.
# PLANS: new vacancies need review + an entitlement (trial / paid credit / Business) to be public. BILLING: employers may open checkout.
EMPLOYER_PLANS_ENABLED=false
EMPLOYER_BILLING_ENABLED=false
# Provider products: Tək vakansiya (one-time 20 AZN) and Biznes (monthly 100 AZN, subscription_period = total length, e.g. 10 Years).
DODO_PRODUCT_ID_EMPLOYER_SINGLE=
DODO_PRODUCT_ID_EMPLOYER_BUSINESS=
# Optional: approve a vacancy automatically when every automatic check passes (default off; a person decides otherwise).
EMPLOYER_VACANCY_AUTO_APPROVE=false

# Matching service (apps/matching-service) and apply worker (apps/apply-worker).
# Tokens must equal the ones in the root .env / apps/apply-worker/.env.
MATCHING_SERVICE_URL=http://localhost:8000
MATCHING_SERVICE_TOKEN=local-matching-token
APPLY_WORKER_URL=http://localhost:8100
APPLY_WORKER_TOKEN=local-worker-token

# Keep these OFF locally: no requests to Glorri, no real external applications.
GLORRI_SCRAPER_ENABLED=false
EXTERNAL_APPLY_LIVE_ENABLED=false
ENABLE_SANDBOX=false
EXTERNAL_APPLY_PILOT_EMAILS=
EXTERNAL_APPLY_PILOT_USER_IDS=

# Scheduled collection of the reviewed public sources. OFF unless exactly "true"; each source ALSO needs scheduled=true in the admin (Mənbələr) and
# no restriction. Keep OFF locally and in any environment that has not been authorised to contact the sources.
SOURCE_SCHEDULE_ENABLED=false
# How often the scheduler looks for a due source: every N minutes (1-59). Leave unset for every 10 minutes; anything else is ignored.
# SOURCE_SCHEDULE_TICK_PATTERN=*/10 * * * *

# Admin MFA: 32 random bytes, base64 (`openssl rand -base64 32`). Local only.
ADMIN_MFA_ENCRYPTION_KEY=

# Tailored CVs (NVIDIA NIM). Empty = no AI calls; tailoring reports it is
# unavailable. Use only your own test key if you need it.
NVIDIA_API_KEY=
# NIM_API_URL=
# NIM_MODEL=openai/gpt-oss-120b
TAILOR_DAILY_LIMIT=10

# Analytics: empty = events are logged, not sent.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Candidate-approved application e-mail. EVERYTHING here is off by default.
# Local development uses the sink (a loopback capture server, `npm run script:email-sink`):
# nothing leaves this machine. Live sending needs RESEND_API_KEY, a verified sender, a
# Svix signing secret and either a recipient allowlist (pilot) or REAL_RECIPIENTS=true
# (only after the founder authorizes contacting employers). The app refuses to start
# with an unsafe live configuration.
EMAIL_APPLY_ENABLED=false
EMAIL_APPLY_TRANSPORT=sink
EMAIL_APPLY_SINK_URL=http://127.0.0.1:4599
# EMAIL_APPLY_FROM="AISE Applications <applications@your-verified-domain>"
# EMAIL_APPLY_WEBHOOK_SECRET=whsec_...
# EMAIL_APPLY_RECIPIENT_ALLOWLIST=pilot@example.com,@controlled-inbox.example
EMAIL_APPLY_REAL_RECIPIENTS=false
# EMAIL_APPLY_USER_DAILY_LIMIT=10
# EMAIL_APPLY_GLOBAL_DAILY_LIMIT=200
# EMAIL_APPLY_RECIPIENT_DAILY_LIMIT=5
# EMAIL_APPLY_MAX_ATTEMPTS=3
# EMAIL_APPLY_PROVIDER_TIMEOUT_MS=30000
# EMAIL_APPLY_RETENTION_DAYS=180
# Mode B (automatic applications) and inbound replies are separate, additional switches.
EMAIL_APPLY_AUTOMATION_ENABLED=false
# Public pages (pricing, landing) present rule-based sending as offered only when this is also true. Set it only after automatic
# sending has been verified in this deployment; the in-app Premium opt-in does not depend on it.
EMAIL_APPLY_AUTOMATION_PUBLISHED=false
EMAIL_APPLY_INBOUND_ENABLED=false

# Optional tuning (defaults shown).
# MATCH_SCORE_THRESHOLD=0.35
# BACKUP_STATUS_FILE=

# Google sign-in for candidates (optional). The client id is public; the SECRET belongs only in the web service environment (root .env), never here or in Git.
# Create an OAuth client (Web application) in Google Cloud Console with the authorized redirect URI https://<your-domain>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Cost report (GET /admin/ops/ai-usage): USD per million input/output tokens by "provider/model", and the USD→AZN rate. Missing = "unknown".
# AI_PRICE_USD_PER_MTOK={"groq/openai/gpt-oss-120b":[0.15,0.6]}
# USD_TO_AZN=1.7

# Optional public LinkedIn reader: only attempted after a direct-read failure and explicit per-request user consent.
# Uses fixed r.jina.ai HTML/JSON endpoint without an API key, cookies or uploaded files. Set false to disable all reader requests.
# LINKEDIN_PUBLIC_READER_ENABLED=true
