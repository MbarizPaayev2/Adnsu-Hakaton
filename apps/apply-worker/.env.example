# apps/apply-worker/.env — copy to `.env` in apps/apply-worker. Never commit it.
# LOCAL DEVELOPMENT ONLY. The worker never sends a real application locally.

PORT=8100
# Must equal APPLY_WORKER_TOKEN in apps/api/.env.
APPLY_WORKER_TOKEN=local-worker-token
EXTERNAL_APPLY_LIVE_ENABLED=false
EXTERNAL_APPLY_MAX_SESSIONS=2
# Optional: a local Chrome/Chromium binary instead of Playwright's download.
# CHROMIUM_PATH=
