# Root .env for `docker compose` (it fills in the ${...} values in
# docker-compose.yml). Copy to `.env` in the repo root — never commit `.env`.
#
# LOCAL DEVELOPMENT ONLY. These are not production values and must never be
# replaced with them. Production secrets live only on the server; if you need
# a real key for your own testing, ask for a separate test key of your own.

# Any long random string (e.g. `openssl rand -hex 32`); use the same value in
# apps/web/.env.local.
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Shared service tokens: any random strings, but each must match the same
# variable in apps/api/.env (and APPLY_WORKER_TOKEN in apps/apply-worker/.env).
MATCHING_SERVICE_TOKEN=local-matching-token
APPLY_WORKER_TOKEN=local-worker-token

# Password for the local Postgres container (first start only).
POSTGRES_PASSWORD=postgrespassword

APP_ENV=development
NEXTAUTH_URL=http://localhost:3000
