// Preamble (auto-generated by resume-tailor.service.ts): #let data = (...)
//
// Motivation letter in the same visual language as resume-harvard.typ: A4, Libertinus Serif (ships inside the Typst compiler and covers
// Azerbaijani, Russian, English and Turkish), monochrome, name block centred on top, body left-aligned.

#set page(paper: "a4", margin: (x: 25mm, top: 22mm, bottom: 22mm))
#set text(font: "Libertinus Serif", size: 11pt, fill: rgb("#232A24"), ligatures: false, lang: data.at("lang", default: "en"))
#set par(leading: 0.7em, justify: false, spacing: 1.1em)

#let name-str  = data.at("name", default: "")
#let email-str = data.at("email", default: "")
#let phone-str = data.at("phone", default: "")
#let loc-str   = data.at("location", default: "")
#let date-str  = data.at("date", default: "")
#let company   = data.at("company", default: "")
#let position  = data.at("position", default: "")
#let rloc      = data.at("recipient_location", default: "")
#let salutation = data.at("salutation", default: "")
#let closing   = data.at("closing", default: "")
#let paragraphs = data.at("paragraphs", default: ())
#let subject-label = data.at("subject_label", default: "")

#align(center)[
  #text(size: 18pt, weight: "bold")[#name-str]
  #v(4pt)
  #text(size: 9.5pt)[
    #{
      let parts = ()
      if loc-str != "" { parts.push(loc-str) }
      if phone-str != "" { parts.push(phone-str) }
      if email-str != "" { parts.push(email-str) }
      parts.join("  \u{2022}  ")
    }
  ]
  #v(2pt)
  #line(length: 100%, stroke: 0.6pt + rgb("#253B2C"))
]

#v(10pt)
#align(right)[#text(size: 10pt)[#date-str]]
#v(6pt)
#if company != "" [
  #text(weight: "bold")[#company] \
]
#if rloc != "" [#rloc \ ]
#if position != "" [#text(style: "italic")[#subject-label #position]]
#v(12pt)

#salutation

#paragraphs.join(parbreak())

#v(8pt)
#closing \
#v(14pt)
#text(weight: "bold")[#name-str]
