# apps/web/.env.local — copy this file to `.env.local` in apps/web.
# Never commit `.env.local`. LOCAL DEVELOPMENT ONLY.
#
# NEXT_PUBLIC_* values are built into the browser bundle: never put a secret
# in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth (server side). Same NEXTAUTH_SECRET as the root .env.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Analytics: leave empty locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
