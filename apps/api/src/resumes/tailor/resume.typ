// Preamble (auto-generated by generate_resume.mjs):
// #let data = (...)
// #let accent = rgb("...")
// #let sidebar-bg = rgb("...")

#set page(
  paper: "a4",
  margin: 0pt,
  background: place(left + top,
    rect(width: 34%, height: 100%, fill: sidebar-bg)
  )
)
#set text(font: "Liberation Sans", size: 9.5pt, fill: rgb("#232A24"), ligatures: false)
#set par(leading: 0.55em, justify: false)
#set list(marker: text(fill: accent)[•], indent: 8pt, body-indent: 4pt)

#let muted = rgb("#D2F77C")
#let sidebar-text = rgb("#F6F7F0")

#let sec(label, dark: false) = {
  v(10pt)
  block(
    width: 100%,
    below: 5pt,
    stroke: (bottom: 0.5pt + if dark { white.transparentize(65%) } else { rgb("#253B2C").transparentize(80%) }),
  )[
    #text(
      size: 7.5pt,
      weight: "bold",
      fill: if dark { white } else { accent },
      tracking: 0.09em,
    )[#upper(label)]
  ]
}

// ── data bindings ─────────────────────────────────────────────
#let name-str     = data.at("name",        default: "")
#let headline-str = data.at("headline",    default: "")
#let email-str    = data.at("email",       default: "")
#let phone-str    = data.at("phone",       default: "")
#let loc-str      = data.at("location",    default: "")
#let site-str     = data.at("website_url", default: "")
#let summary-str  = data.at("summary",     default: "")
#let exp-list     = data.at("experience",  default: ())
#let edu-list     = data.at("education",   default: ())
#let skills-list  = data.at("skills",      default: ())
#let langs-list   = data.at("languages",   default: ())
#let proj-list    = data.at("projects",    default: ())
#let certs-list   = data.at("certifications", default: ())

// ── sidebar ───────────────────────────────────────────────────
#let sidebar = pad(x: 10mm, top: 18mm, bottom: 14mm)[
  #text(size: 17pt, weight: "bold", fill: white)[#name-str]
  #v(4pt)
  #text(size: 9pt, fill: muted, weight: "medium")[#headline-str]
  #v(6pt)
  #line(length: 36pt, stroke: 2.5pt + rgb("#D2F77C"))

  #sec("Contact", dark: true)

  #for (lbl, val) in (
    ("Email",    email-str),
    ("Phone",    phone-str),
    ("Location", loc-str),
    ("Web",      site-str),
  ) {
    if val != "" {
      block(below: 6pt)[
        #text(size: 7pt, fill: muted, tracking: 0.07em)[#upper(lbl)] \
        #text(size: 8pt, fill: sidebar-text)[#val]
      ]
    }
  }

  #if skills-list.len() > 0 {
    sec("Skills", dark: true)
    for s in skills-list {
      let nm  = s.at("name",     default: "")
      let kws = s.at("keywords", default: ())
      block(below: 5pt)[
        #if nm != "" {
          text(size: 8.5pt, weight: "bold", fill: white)[#nm]
          linebreak()
        }
        #for kw in kws {
          box(
            stroke: 0.4pt + white.transparentize(65%),
            fill: white.transparentize(88%),
            radius: 9999pt,
            inset: (x: 5pt, y: 1.5pt),
          )[#text(size: 7pt, fill: sidebar-text)[#kw]]
          h(2pt)
        }
      ]
    }
  }

  #if langs-list.len() > 0 {
    sec("Languages", dark: true)
    for L in langs-list {
      block(below: 4pt)[
        #grid(
          columns: (1fr, auto),
          gutter: 0pt,
          text(size: 8.5pt, fill: white, weight: "bold")[#L.at("language", default: "")],
          text(size: 8pt,   fill: muted)[#L.at("fluency",  default: "")],
        )
      ]
    }
  }

  #if certs-list.len() > 0 {
    sec("Certifications", dark: true)
    for c in certs-list {
      let iss = c.at("issuer", default: "")
      let dt  = c.at("date",   default: "")
      block(below: 5pt)[
        #text(size: 8.5pt, weight: "bold", fill: white)[#c.at("title", default: "")]
        #if iss != "" or dt != "" {
          linebreak()
          text(size: 7.5pt, fill: muted)[#iss #dt]
        }
      ]
    }
  }
]

// ── main column ───────────────────────────────────────────────
#let main-col = pad(x: 11mm, top: 16mm, bottom: 14mm)[
  #if summary-str != "" {
    sec("Profile")
    block(below: 9pt)[
      #text(size: 9.5pt, fill: rgb("#232A24"))[#summary-str]
    ]
  }

  #if exp-list.len() > 0 {
    sec("Experience")
    for e in exp-list {
      let highs = e.at("highlights", default: ())
      let loc   = e.at("location",   default: "")
      block(below: 10pt)[
        #grid(
          columns: (1fr, auto),
          gutter: 0pt,
          text(size: 10.5pt, weight: "bold", fill: rgb("#232A24"))[#e.at("position", default: "")],
          text(size: 8pt, fill: accent, weight: "semibold")[#e.at("period", default: "")],
        )
        #v(1pt)
        #text(size: 8.5pt, fill: rgb("#667064"))[
          #e.at("company", default: "")#if loc != "" [#h(4pt)·#h(4pt)#loc]
        ]
        #if highs.len() > 0 {
          v(3pt)
          list(..highs.map(blt => [#text(size: 9pt, fill: rgb("#232A24"))[#blt]]))
        }
      ]
    }
  }

  #if edu-list.len() > 0 {
    sec("Education")
    for e in edu-list {
      let degree = e.at("degree", default: "")
      let area   = e.at("area",   default: "")
      let line   = (degree + " " + area).trim()
      let loc    = e.at("location", default: "")
      let grade  = e.at("grade",    default: "")
      block(below: 9pt)[
        #grid(
          columns: (1fr, auto),
          gutter: 0pt,
          text(size: 10.5pt, weight: "bold", fill: rgb("#232A24"))[#line],
          text(size: 8pt, fill: accent, weight: "semibold")[#e.at("period", default: "")],
        )
        #v(1pt)
        #text(size: 8.5pt, fill: rgb("#667064"))[
          #e.at("school", default: "")#if loc != "" [#h(4pt)·#h(4pt)#loc]
        ]
        #if grade != "" {
          v(1pt)
          text(size: 8pt, fill: rgb("#667064"))[#grade]
        }
      ]
    }
  }

  #if proj-list.len() > 0 {
    sec("Projects")
    for p in proj-list {
      let desc = p.at("description", default: "")
      block(below: 9pt)[
        #grid(
          columns: (1fr, auto),
          gutter: 0pt,
          text(size: 10.5pt, weight: "bold", fill: rgb("#232A24"))[#p.at("name", default: "")],
          text(size: 8pt, fill: accent, weight: "semibold")[#p.at("period", default: "")],
        )
        #if desc != "" {
          v(2pt)
          text(size: 9pt, fill: rgb("#232A24"))[#desc]
        }
      ]
    }
  }
]

// ── page layout ───────────────────────────────────────────────
#grid(
  columns: (34%, 1fr),
  gutter: 0pt,
  sidebar,
  main-col,
)
